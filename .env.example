GNANI_API_KEY=
EVON_BASE_URL=https://<your-gpu-host>:8000/v1
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# vllm (BF16, paid GPU) | llamacpp (free Kaggle 4-bit GGUF, see EVON_FREE.md; EVON_MODEL=evon) | none (rules check / demo)
EVON_PROVIDER=vllm
EVON_LABEL=
EVON_QUANT=
EVON_TIMEOUT=90
FRONTEND_ORIGIN=http://localhost:5173
DEMO_ONLY=false
# per visitor per hour (protects the Gnani credit on a public deployment)
ANALYSES_PER_HOUR=3
RECALLS_PER_HOUR=20
LISTENS_PER_HOUR=6
ADMIN_SECRET=
DATA_DIR=./data
# frontend/.env holds VITE_API_URL=http://localhost:8000
# never add ANTHROPIC_API_KEY here
